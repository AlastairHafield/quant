TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists. Deliberately set to the SAME account as Mechanical ORB's
# MECHANICAL_ORB_ACCOUNT_NAME (both trade the 50KTC-V2-DLL-416538-32353936 Combine) —
# a bot-specific var name is still used so each bot's config stays independently
# readable/toggleable even though the value happens to coincide.
GAP_CONTINUATION_ACCOUNT_NAME=

DISCORD_WEBHOOK=
LOG_WEBHOOK=

BACKEND_URL=http://localhost:3001
GAP_CONTINUATION_STATUS_SECRET=

INSTRUMENT=MES

# Bot-specific (not shared with gex-breakout's/mechanical-orb's own EXECUTION_ENABLED
# vars) so each bot's live trading can be toggled independently.
GAP_CONTINUATION_EXECUTION_ENABLED=false

# Persistent trade journal (every signal + every real trade) — durable across
# restarts. Same value as the other bots' .env (shared cluster, Heroku config
# vars are app-wide anyway) — connects to its own database name (gap_continuation).
MONGODB_URI=

TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists. Deliberately set to the SAME account as Mechanical ORB's
# MECHANICAL_ORB_ACCOUNT_NAME (both trade the 50KTC-V2-DLL-416538-32353936 Combine) —
# a bot-specific var name is still used so each bot's config stays independently
# readable/toggleable even though the value happens to coincide.
GAP_CONTINUATION_ACCOUNT_NAME=

# Practice-account shadow mode (topstep-prop-firm-plan Phase 4) — set
# ACCOUNT_MODE=practice to trade a TopstepX practice/eval account instead of
# the real Combine (e.g. while validating the Order Flow Bot's redesign, or
# shadowing a proposed change before it's promoted to live). Leave unset
# ("live") for normal operation — a bot must be EXPLICITLY told to run in
# practice mode. GAP_CONTINUATION_PRACTICE_ACCOUNT_NAME is required whenever
# ACCOUNT_MODE=practice and more than one tradable account exists.
ACCOUNT_MODE=live
GAP_CONTINUATION_PRACTICE_ACCOUNT_NAME=

DISCORD_WEBHOOK=
LOG_WEBHOOK=

BACKEND_URL=http://localhost:3001
GAP_CONTINUATION_STATUS_SECRET=

INSTRUMENT=MES

# Bot-specific (not shared with gex-breakout's/mechanical-orb's own EXECUTION_ENABLED
# vars) so each bot's live trading can be toggled independently.
GAP_CONTINUATION_EXECUTION_ENABLED=false

# Persistent trade journal (every signal + every real trade) — durable across
# restarts. Same value as the other bots' .env (shared cluster, Heroku config
# vars are app-wide anyway) — connects to its own database name (gap_continuation).
# Also backs the shared global kill switch (shared/killSwitch.js, "control" db).
MONGODB_URI=

# Account-WIDE daily loss cap in $, shared with every other bot trading this
# same real Combine (mechanical-orb) — set the SAME value in all three bots'
# env, since each enforces it independently against the broker's own account
# balance (shared/accountRisk.js). Unset = NOT enforced (the worker logs a
# startup warning so this can't go unnoticed). Does not apply when
# ACCOUNT_MODE=practice — a practice account isn't real money.
ACCOUNT_DAILY_LOSS_CAP_DOLLARS=

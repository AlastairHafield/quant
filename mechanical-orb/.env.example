TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists. The code refuses to guess rather than risk trading the
# wrong one. Bot-specific var name (not shared with gex-breakout's own
# TOPSTEPX_ACCOUNT_NAME) since Heroku config vars are shared across all dynos of an
# app — these two bots deliberately trade different accounts.
MECHANICAL_ORB_ACCOUNT_NAME=

DISCORD_WEBHOOK=
LOG_WEBHOOK=

BACKEND_URL=http://localhost:3001
MECHANICAL_ORB_STATUS_SECRET=

INSTRUMENT=MES

# Bot-specific (not shared with gex-breakout's EXECUTION_ENABLED) so each bot's live
# trading can be toggled independently.
MECHANICAL_ORB_EXECUTION_ENABLED=false

# Persistent trade journal (every signal + every real trade) — durable across
# restarts, unlike the in-memory log buffer. Same value as gex-breakout's
# .env (shared cluster, Heroku config vars are app-wide anyway) — each bot
# connects to its own database name (gex_breakout / mechanical_orb) within it.
# Also backs the shared global kill switch (shared/killSwitch.js, "control" db).
MONGODB_URI=

# Account-WIDE daily loss cap in $, shared with every other bot trading this
# same real Combine (gap-continuation, gex-breakout's Strategy B) — set the
# SAME value in all three bots' env, since each enforces it independently
# against the broker's own account balance (shared/accountRisk.js). Unset =
# NOT enforced (the worker logs a startup warning so this can't go unnoticed).
ACCOUNT_DAILY_LOSS_CAP_DOLLARS=

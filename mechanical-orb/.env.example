TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists. The code refuses to guess rather than risk trading the
# wrong one. Bot-specific var name (not shared with gex-breakout's own
# TOPSTEPX_ACCOUNT_NAME) since Heroku config vars are shared across all dynos of an
# app — these two bots deliberately trade different accounts.
MECHANICAL_ORB_ACCOUNT_NAME=

DISCORD_WEBHOOK=
LOG_WEBHOOK=

BACKEND_URL=http://localhost:3001
MECHANICAL_ORB_STATUS_SECRET=

INSTRUMENT=MES

# Bot-specific (not shared with gex-breakout's EXECUTION_ENABLED) so each bot's live
# trading can be toggled independently.
MECHANICAL_ORB_EXECUTION_ENABLED=false

TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists (e.g. active Combines alongside the practice account).
# The code refuses to guess rather than risk trading the wrong one.
TOPSTEPX_ACCOUNT_NAME=
DISCORD_WEBHOOK=
LOG_WEBHOOK=

# Where the backend (web dyno) lives, so this worker can push its live status there
# for the dashboard to read — Heroku doesn't route public traffic to worker dynos.
BACKEND_URL=http://localhost:3001
GEX_STATUS_SECRET=

INSTRUMENT_TRADE=MES
INSTRUMENT_DATA=ES

EXECUTION_ENABLED=false

# The Order Flow Bot needs this set separately from EXECUTION_ENABLED above
# before it will place real orders — it can be held back in signal-only mode
# even while the bot-wide switch is live on a real account.
STRATEGY_OF_EXECUTION_ENABLED=false

# The Order Flow Bot trades its own account, independent of TOPSTEPX_ACCOUNT_NAME
# above (e.g. the practice account, while TOPSTEPX_ACCOUNT_NAME points at a real
# Combine for everything else). Required once STRATEGY_OF_EXECUTION_ENABLED is
# true and more than one tradable account exists.
STRATEGY_OF_ACCOUNT_NAME=

# Manual on/off toggle for macro/geopolitical bias override (see config.js) —
# defaults on; set to "false" by hand around known event risk (FOMC, CPI, etc).
ORDER_FLOW_MACRO_ON=true

# Persistent trade journal (every signal + every real trade) — durable across
# restarts, unlike the in-memory log buffer. Shared cluster across both bots'
# .env files, each connects to its own database name (gex_breakout /
# mechanical_orb) within it. Also backs the shared global kill switch
# (shared/killSwitch.js, "control" db).
MONGODB_URI=

# Account-WIDE daily loss cap in $ on the real Combine (role "default"), shared
# with every other bot trading it (gap-continuation, mechanical-orb) — set the
# SAME value in all three bots' env, since each enforces it independently
# against the broker's own account balance (shared/accountRisk.js). Does NOT
# apply to the Order Flow Bot's practice account. Unset = NOT enforced (the
# worker logs a startup warning so this can't go unnoticed).
ACCOUNT_DAILY_LOSS_CAP_DOLLARS=

FLASHALPHA_KEY=
TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists (e.g. active Combines alongside the practice account).
# The code refuses to guess rather than risk trading the wrong one.
TOPSTEPX_ACCOUNT_NAME=
DISCORD_WEBHOOK=
LOG_WEBHOOK=

# Where the backend (web dyno) lives, so this worker can push its live status there
# for the dashboard to read — Heroku doesn't route public traffic to worker dynos.
BACKEND_URL=http://localhost:3001
GEX_STATUS_SECRET=

INSTRUMENT_TRADE=MES
INSTRUMENT_DATA=ES
UNDERLYING_OPTIONS=SPX

EXECUTION_ENABLED=false

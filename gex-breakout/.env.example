FLASHALPHA_KEY=
TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Substring of the TopstepX account name to trade — required whenever more than one
# tradable account exists (e.g. active Combines alongside the practice account).
# The code refuses to guess rather than risk trading the wrong one.
TOPSTEPX_ACCOUNT_NAME=
DISCORD_WEBHOOK=
LOG_WEBHOOK=

# Where the backend (web dyno) lives, so this worker can push its live status there
# for the dashboard to read — Heroku doesn't route public traffic to worker dynos.
BACKEND_URL=http://localhost:3001
GEX_STATUS_SECRET=

INSTRUMENT_TRADE=MES
INSTRUMENT_DATA=ES
UNDERLYING_OPTIONS=SPX

EXECUTION_ENABLED=false

# Strategy A (the 15-min ORB variant) needs this set separately from
# EXECUTION_ENABLED above before it will place real orders — it can be held
# back in signal-only mode even while Strategy B and the bot-wide switch are
# live on a real account.
STRATEGY_A_EXECUTION_ENABLED=false

# Strategy A trades its own account, independent of TOPSTEPX_ACCOUNT_NAME above
# (e.g. the practice account, while TOPSTEPX_ACCOUNT_NAME points at a real
# Combine for everything else). Required once STRATEGY_A_EXECUTION_ENABLED is
# true and more than one tradable account exists.
STRATEGY_A_ACCOUNT_NAME=

# Persistent trade journal (every signal + every real trade) — durable across
# restarts, unlike the in-memory log buffer. Shared cluster across both bots'
# .env files, each connects to its own database name (gex_breakout /
# mechanical_orb) within it.
MONGODB_URI=

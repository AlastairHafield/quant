FMP_API_KEY=
PORT=3001
NODE_ENV=development
# Alpaca market data (data.alpaca.markets) — used for real 1-minute ORB bars.
# Paper or live account keys both work for historical market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Read-only access to gex-breakout's trade journal for the Trade Journal tab.
# Same value as gex-breakout/mechanical-orb's .env — Heroku config vars are
# app-wide anyway.
MONGODB_URI=

# TopstepX — used for overnight/pre-market ES/MES 1-minute bars (FMP/Alpaca/
# Yahoo have no coverage there). Same credentials as gex-breakout/mechanical-
# orb/gap-continuation's .env — Heroku config vars are app-wide anyway. No
# third-party market-data vendor (2026-09-04: dropped Databento in favor of
# TopstepX-only, see backend/src/api/topstepxHistory.js).
TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=

# Dedicated Discord channel for the Phase 5 agent harness's thesis/critique/
# decision exchange (see agent-harness/PROTOCOL.md) — every audit-log entry
# posts here. Falls back to DISCORD_WEBHOOK (the trading-alerts channel) if
# unset, so this is optional until a dedicated channel/webhook is set up.
AGENT_HARNESS_DISCORD_WEBHOOK=
